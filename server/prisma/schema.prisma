generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectPermission {
  preview_own_tasks
  preview_all_tasks
  edit_own_tasks
  edit_all_tasks
  admin
}

enum ProjectAccessStatus {
  invited
  active
  revoked
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  emailVerified      Boolean                  @default(false)
  emailVerifiedAt    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  projects           Project[]
  teamMembers        TeamMember[]
  tasks              Task[]
  projectAccesses    ProjectAccess[]     @relation("ProjectAccessUser")
  ownedAccesses      ProjectAccess[]     @relation("ProjectAccessOwner")
  ownedInvitations   ProjectInvitation[] @relation("ProjectInvitationOwner")
  acceptedInvitations ProjectInvitation[] @relation("ProjectInvitationAcceptedBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  email      String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([email, purpose])
}

model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  aiContext      String?
  status         String          @default("active")
  color          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectMembers ProjectMember[]
  projectAccesses ProjectAccess[]
  invitations    ProjectInvitation[]
  tasks          Task[]

  @@index([userId])
}

model TeamMember {
  id             String          @id @default(cuid())
  name           String
  role           String
  email          String
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectMembers ProjectMember[]
  tasks          Task[]
  taskAssignees  TaskAssignee[]
  invitations    ProjectInvitation[]
  projectAccesses ProjectAccess[]

  @@unique([userId, email])
  @@index([userId])
}

model ProjectMember {
  projectId    String
  teamMemberId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@id([projectId, teamMemberId])
}

model ProjectAccess {
  id             String              @id @default(cuid())
  projectId      String
  ownerUserId    String
  userId         String
  teamMemberId   String?
  permission     ProjectPermission
  status         ProjectAccessStatus @default(invited)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerUser      User                @relation("ProjectAccessOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  user           User                @relation("ProjectAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  teamMember     TeamMember?         @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([ownerUserId, userId, status])
  @@index([projectId, status])
}

model ProjectInvitation {
  id               String            @id @default(cuid())
  projectId        String
  ownerUserId      String
  teamMemberId     String
  inviteEmail      String
  permission       ProjectPermission
  tokenHash        String            @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  acceptedByUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerUser        User              @relation("ProjectInvitationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  teamMember       TeamMember        @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  acceptedByUser   User?             @relation("ProjectInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, inviteEmail, revokedAt, acceptedAt])
  @@index([ownerUserId, inviteEmail])
}

model TaskAssignee {
  taskId       String
  teamMemberId String
  createdAt    DateTime   @default(now())
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)

  @@id([taskId, teamMemberId])
  @@index([teamMemberId])
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  notes         String?
  status        String         @default("todo")
  isDefect      Boolean        @default(false)
  deadline      DateTime?
  startDate     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  projectId     String
  assigneeId    String
  parentTaskId  String?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      TeamMember     @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  parentTask    Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks      Task[]         @relation("TaskSubtasks")
  taskAssignees TaskAssignee[]
  attachments   TaskAttachment[]
  archive       TaskAttachmentArchive?

  @@index([deadline])
  @@index([completedAt])
  @@index([userId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([parentTaskId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId      String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String   @unique
  isImage     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskAttachmentArchive {
  id          String   @id @default(cuid())
  taskId       String   @unique
  storageKey   String   @unique
  sizeBytes    Int
  generatedAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
